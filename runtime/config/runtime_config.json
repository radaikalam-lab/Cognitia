{
  "runtime_identity": "Cognitia",
  "runtime_version": "1.0.0",
  "cognitive_abi_version": "1.0.0",
  "protocol_version": "1.0.0",
  "host": "127.0.0.1",
  "port": 8000,
  "max_request_size_bytes": 524288,
  "rate_limiting": {
    "max_requests_per_minute": 600
  },
  "epistemic": {
    "max_nodes": 50000
  },
  "persistence": {
    "enabled": true,
    "backend": "file",
    "data_dir": "/var/lib/cognitia/epistemic",
    "durability": "sync",
    "snapshot_interval_records": 1000,
    "journal_max_bytes": 268435456,
    "ephemeral_mode": false
  },
  "security": {
    "require_local_binding": true,
    "allow_dynamic_provider_registration": false
  }
}