{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "CognitiaEvidenceApiV1",
  "type": "object",
  "required": [
    "id",
    "schema_version",
    "created_at",
    "target_id",
    "direction"
  ],
  "properties": {
    "id": {
      "type": "string",
      "format": "uuid"
    },
    "schema_version": {
      "type": "string",
      "pattern": "^1\\.[0-9]+\\.[0-9]+$"
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "target_id": {
      "type": "string"
    },
    "direction": {
      "type": "string",
      "enum": ["SUPPORT", "REFUTE", "NEUTRAL"]
    },
    "confidence": {
      "type": "number",
      "minimum": 0.0,
      "maximum": 1.0
    },
    "weight": {
      "type": "number",
      "minimum": 0.0
    },
    "observation_ids": {
      "type": "array",
      "items": { "type": "string" }
    },
    "metadata": {
      "type": "object"
    }
  },
  "additionalProperties": false
}