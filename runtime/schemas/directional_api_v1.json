{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "CognitiaDirectionalSpecificationApiV1",
  "type": "object",
  "required": [
    "id",
    "schema_version",
    "created_at",
    "objectives"
  ],
  "properties": {
    "id": {
      "type": "string",
      "format": "uuid"
    },
    "schema_version": {
      "type": "string",
      "pattern": "^1\\.[0-9]+\\.[0-9]+$"
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "objectives": {
      "type": "array",
      "items": { "type": "object" }
    },
    "constraints": {
      "type": "array",
      "items": { "type": "object" }
    },
    "success_criteria": {
      "type": "array",
      "items": { "type": "object" }
    },
    "metadata": {
      "type": "object"
    }
  },
  "additionalProperties": false
}